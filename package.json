{
  "name": "geo",
  "version": "3.1.3",
  "description": "Geographical and geopolitical database for the world",
  "homepage": "https://github.com/ekkis/geo.git",
  "author": {
    "name": "Erick Calder",
    "url": "https://github.com/users/ekkis",
    "email": "ett+github@ekkis.id"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ekkis/geo.git"
  },
  "bugs": {
    "url": "https://github.com/ekkis/geo/issues"
  },
  "license": "MIT",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/ekkis/geo/blob/master/LICENSE"
    }
  ],
  "main": "index.js",
  "keywords": [
    "country",
    "geopolitical",
    "iso2",
    "iso3",
    "phone",
    "continent",
    "capital",
    "region"
  ],
  "scripts": {
    "build": "node scripts/build-browser.js",
    "start": "node service/server.js",
    "dev": "node --watch service/server.js",
    "test": "npm run lint && node --test t/*.js test/*.mjs",
    "preversion": "npm run test",
    "version": "",
    "postversion": "git push --tags && npm publish",
    "debug": "node --inspect-brk eg",
    "lint": "eslint *.js cli t/*.js test/*.mjs scripts/build-browser.js",
    "smoke:vowlabs": "node scripts/smoke-vowlabs-service.js"
  },
  "devDependencies": {
    "eslint": "^9.32.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "micro": "^9.3.3",
    "remote-lib": "git+https://github.com/ekkis/remote-lib.git"
  }
}
